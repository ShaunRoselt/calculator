{
  "name": "calculator",
  "version": "12.2.0",
  "description": "Roselt Calculator is an installable calculator app with standard, scientific, programmer, graphing, date, and conversion modes.",
  "desktopName": "io.github.ShaunRoselt.Calculator.desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test \"test/**/*.test.js\"",
    "capture:steam:screenshots": "node marketing/steam/capture_full_page_screenshots.cjs",
    "create:steam:trailer": "node marketing/steam/create_trailer.cjs",
    "generate:steam:store": "node marketing/steam/generate_store_images.cjs",
    "generate:logos:png": "node assets/logos/generate_png_logos.cjs",
    "package:flatpak": "npm run package:linux && sh scripts/package-flatpak.sh",
    "package:linux:appimage": "node scripts/package-appimage.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "package:mac": "node scripts/package-macos.cjs",
    "package:win": "node scripts/package-windows.cjs",
    "sync:final-dist": "node scripts/final-dist.cjs",
    "start": "python3 -m http.server 4173",
    "start:desktop": "electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaunRoselt/calculator.git"
  },
  "keywords": [],
  "author": "Shaun Roselt",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ShaunRoselt/calculator/issues"
  },
  "homepage": "https://github.com/ShaunRoselt/calculator#readme",
  "private": true,
  "build": {
    "appId": "io.github.ShaunRoselt.Calculator",
    "productName": "Roselt Calculator",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!.venv{,/**/*}",
      "!.git{,/**/*}",
      "!.github{,/**/*}",
      "!.vscode{,/**/*}",
      "!.build-tools{,/**/*}",
      "!.copilot-translation-chunks{,/**/*}",
      "!.tmp-piqad-font{,/**/*}",
      "!flatpak{,/**/*}",
      "!.flatpak-builder{,/**/*}",
      "!marketing{,/**/*}",
      "!docs{,/**/*}",
      "!test{,/**/*}",
      "!Saves{,/**/*}",
      "!scripts/benchmark{,/**/*}",
      "!**/*.md",
      "!CNAME"
    ],
    "asar": true,
    "compression": "store",
    "linux": {
      "artifactName": "Roselt-Calculator-${version}.${ext}",
      "executableName": "calculator",
      "category": "Utility",
      "icon": "assets/icons/app-icon-4096.png"
    },
    "appImage": {
      "artifactName": "Roselt-Calculator-${version}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icons/app-icon-dark.ico"
    },
    "portable": {
      "artifactName": "Roselt-Calculator-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "*",
    "electron-builder": "*",
    "resedit": "*"
  },
  "overrides": {
    "app-builder-lib@26.18.1": {
      "minimatch@^10.2.5": "11.0.9"
    },
    "@electron/universal@2.0.3": {
      "minimatch@^9.0.3": "11.0.9"
    }
  }
}
